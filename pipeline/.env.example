# Copy this file to pipeline/.env and fill in your values for local testing.
# These are NOT committed to Git — they're injected as GitHub Secrets in CI.

# ── Required ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...your-service-role-key...
NVIDIA_KEY=nvapi-...your-nvidia-key...

# ── Optional fallbacks (pipeline works without these, but uses them when set) ─
# GEMINI_KEY=AIzaSy...your-gemini-key...
# OPENAI_KEY=sk-proj-...your-openai-key...
