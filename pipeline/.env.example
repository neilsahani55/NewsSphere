# Supabase project credentials (service role — never expose in the browser)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# AI enrichment keys — pipeline tries in order: NVIDIA → Gemini → OpenAI
NVIDIA_KEY=your-nvidia-nim-api-key
GEMINI_KEY=your-google-gemini-api-key
OPENAI_KEY=your-openai-api-key

# Pipeline group (1, 2, or 3 — set automatically by GitHub Actions workflows)
PIPELINE_GROUP=1
