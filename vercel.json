{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/sitemap.xml",    "destination": "/api/sitemap" },
    { "source": "/news/:slug",     "destination": "/api/og?slug=:slug" },
    { "source": "/((?!api|assets|favicon|robots|sitemap|og-).*)", "destination": "/index.html" }
  ]
}
