# Copy this file to .env and fill in your values.
# All VITE_ vars are exposed to the browser — they are safe to expose
# because Supabase RLS controls data access and Google's client_id is public.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-key...

# Google OAuth 2.0 client ID for sign-in (from Google Cloud Console → Credentials)
# The domain this app runs on must be listed in "Authorized JavaScript origins"
# for this client: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
